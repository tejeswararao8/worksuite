# WorkSuite HRMS — Backend Environment Variables
# Copy this file to platform/app/.env and fill in your values,
# or export these as environment variables before starting the application.
# NEVER commit a file containing real credentials.
#
# When running with Maven:
#   export DB_USERNAME=youruser && mvn spring-boot:run -Dspring-boot.run.profiles=dev
#
# When running with Docker:
#   Set these in your docker-compose .env file or as container environment variables.

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vvesolutions_db
DB_USERNAME=
DB_PASSWORD=

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KC_URL=http://localhost:8080
KC_REALM=vve-platform
KC_ISSUER_URI=http://localhost:8080/realms/vve-platform
KC_ADMIN_CLIENT_ID=admin-cli
KC_ADMIN_USERNAME=
KC_ADMIN_PASSWORD=

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=vve-documents

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/company_chat_db

# ─── OpenSearch ───────────────────────────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_FILE=./backend.log
