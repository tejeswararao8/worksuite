# WorkSuite HRMS — Frontend Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env — it is gitignored.
#
# ─── Backend API ─────────────────────────────────────────────────────────────
REACT_APP_API_BASE_URL=http://localhost:8081/api/v1

# ─── Keycloak ────────────────────────────────────────────────────────────────
REACT_APP_KC_URL=http://localhost:8080
REACT_APP_KC_REALM=
REACT_APP_KC_CLIENT_ID=

# ─── SECURITY WARNING ────────────────────────────────────────────────────────
# REACT_APP_KC_CLIENT_SECRET must NOT be set here or in any committed file.
#
# A Keycloak client secret embedded in a React build is fully visible to any
# browser user via the JavaScript bundle. It provides no security.
#
# Required action before production:
#   Option A (recommended): Configure the Keycloak client as "public" access
#   type. Public clients do not use a client secret. ROPC and Authorization
#   Code flows both work without one.
#
#   Option B (future): Migrate to Authorization Code + PKCE via a
#   Backend-for-Frontend (BFF) proxy. The BFF holds the client secret
#   server-side and the browser never sees it.
#
# For local development only, if your Keycloak client is currently
# "confidential" and you have not yet switched it to "public", you may
# temporarily set this variable in your LOCAL .env file only.
# It will not be committed.
#
# REACT_APP_KC_CLIENT_SECRET=
