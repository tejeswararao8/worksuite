# WorkSuite HRMS — Web Frontend Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env — it is gitignored.
#
# ─── Backend API ─────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8081/api/v1

# ─── Keycloak ────────────────────────────────────────────────────────────────
REACT_APP_KC_URL=http://localhost:8080
REACT_APP_KC_REALM=
REACT_APP_KC_CLIENT_ID=

# ─── SECURITY WARNING ────────────────────────────────────────────────────────
# REACT_APP_KC_CLIENT_SECRET must NOT be set here or in any committed file.
# See platform/frontend/.env.example for the full explanation and migration
# options.
#
# REACT_APP_KC_CLIENT_SECRET=
