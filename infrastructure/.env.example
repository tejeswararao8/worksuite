# WorkSuite HRMS — Docker Infrastructure Environment Variables
# Copy this file to infrastructure/.env and fill in your values.
# NEVER commit infrastructure/.env — it is gitignored.
#
# docker compose reads this file automatically when it is named .env
# and placed in the same directory as docker-compose.yml.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_DB=

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
